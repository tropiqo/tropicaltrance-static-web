{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tropicaltrance.invalid/website-editorial/v1/schema.json",
  "title": "Website-owned bilingual Flavor editorial content",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "kind", "flavor"],
  "properties": {
    "contractVersion": { "const": "1" },
    "kind": { "const": "website-editorial" },
    "flavor": { "$ref": "publication/common.schema.json#/$defs/flavorRef" },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translations"],
      "properties": {
        "translations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "es-MX"],
          "properties": {
            "en": { "$ref": "#/$defs/storyLocale" },
            "es-MX": { "$ref": "#/$defs/storyLocale" }
          }
        }
      }
    }
  },
  "$defs": {
    "storyLocale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "paragraphs"],
      "properties": {
        "title": { "$ref": "publication/common.schema.json#/$defs/text" },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "publication/common.schema.json#/$defs/text" }
        }
      }
    }
  }
}
