---
import type { PublicFlavor } from './public-view';
interface Props { flavors: PublicFlavor[]; }
import FlavorDiscovery from './FlavorDiscovery.astro';
import EmptyCollectionState from './EmptyCollectionState.astro';
const { flavors } = Astro.props;
---
<section class="collection-section" aria-label="Flavors collection">
  <div class="container">
    {flavors.length === 0 ? <EmptyCollectionState /> : <FlavorDiscovery flavors={flavors} />}
  </div>
</section>
