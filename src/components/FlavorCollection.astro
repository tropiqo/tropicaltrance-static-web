---
import type { PublicFlavor } from './public-view';
interface Props { flavors: PublicFlavor[]; locale?: 'en' | 'es-MX'; messages: any; }
import FlavorDiscovery from './FlavorDiscovery.astro';
import EmptyCollectionState from './EmptyCollectionState.astro';
const { flavors, locale = 'en', messages } = Astro.props;
---
<section class="collection-section" aria-label={messages.flavors.collectionLabel}>
  <div class="container">
    {flavors.length === 0 ? <EmptyCollectionState locale={locale} messages={messages} /> : <FlavorDiscovery flavors={flavors} locale={locale} messages={messages} />}
  </div>
</section>
