---
import type { PublicEditorial } from './public-view';
interface Props { editorial?: PublicEditorial; }
import SectionHeading from './SectionHeading.astro';
const { editorial } = Astro.props;
---
{editorial && <section class="flavor-story" aria-label="Flavor story">
  <SectionHeading title="Trancy’s Worlds" eyebrow="Flavor story" />
  <div class="story-copy">
    {editorial.title && <h3>{editorial.title}</h3>}
    {editorial.paragraphs.map(text => <p>{text}</p>)}
  </div>
</section>}
