---
import { apparelProducts } from '../data/apparel-products.mjs';
interface Props { messages: any; locale: 'en' | 'es-MX'; }
const { messages, locale } = Astro.props;
---
<section class="apparel-showcase container" aria-labelledby="apparel-showcase-heading">
  <div class="apparel-showcase__intro">
    <p class="eyebrow">{messages.eyebrow}</p>
    <h2 id="apparel-showcase-heading">{messages.galleryTitle}</h2>
    <p class="lead">{messages.galleryLead}</p>
  </div>
  <ul class="apparel-grid" aria-label={messages.galleryLabel}>
    {apparelProducts.map(product => {
      const copy = messages.products[product.id];
      return <li>
        <article class="apparel-card">
          <div class="apparel-card__copy">
            <span class="apparel-card__status">{messages.conceptLabel}</span>
            <h3>{copy.name}</h3>
            <p>{copy.description}</p>
          </div>
          <figure class="apparel-visual">
            <div class="apparel-photo-grid" role="group" aria-label={copy.imageGalleryLabel}>
              {product.artwork.images.map((image, index) => {
                const dialogId = `apparel-image-${product.id}-${index + 1}-${locale}`;
                return <div class="apparel-photo-grid__item">
                  <button class="apparel-photo-grid__trigger" type="button" command="show-modal" commandfor={dialogId} aria-label={messages.viewImageLabel.replace('{description}', image.alt[locale])}>
                    <img
                      src={`/${image.path}`}
                      alt={image.alt[locale]}
                      width={image.width}
                      height={image.height}
                      loading={index === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </button>
                  <dialog class="apparel-image-dialog" id={dialogId} data-apparel-image-dialog data-image-index={index} aria-label={image.alt[locale]}>
                    <img src={`/${image.path}`} alt={image.alt[locale]} width={image.width} height={image.height} loading="lazy" decoding="async" />
                    <div class="apparel-image-dialog__controls" role="group" aria-label={messages.imageControlsLabel}>
                      <button class="apparel-image-dialog__nav" type="button" data-carousel-step="-1" aria-label={messages.previousImage} hidden>←</button>
                      <p class="apparel-image-dialog__position" aria-live="polite">{messages.imagePosition.replace('{current}', String(index + 1)).replace('{total}', String(product.artwork.images.length))}</p>
                      <button class="apparel-image-dialog__nav" type="button" data-carousel-step="1" aria-label={messages.nextImage} hidden>→</button>
                      <button class="apparel-image-dialog__close" type="button" command="close" commandfor={dialogId} aria-label={messages.closeImage}>×</button>
                    </div>
                  </dialog>
                </div>;
              })}
            </div>
            <figcaption>{messages.imagesCaption}</figcaption>
          </figure>
        </article>
      </li>;
    })}
  </ul>
  <p class="apparel-approval-note">{messages.approvalNote}</p>
</section>
