---
import type { PublicFlavor } from './public-view';
interface Props { flavor: PublicFlavor; }
import MediaFrame from './MediaFrame.astro';
import FlavorStory from './FlavorStory.astro';
const { flavor } = Astro.props;
---
<div class="container flavor-detail">
  <a class="detail-return" href="/flavors/">Return to Flavors</a>
  <div class="detail-grid">
    <div class="detail-copy">
      <p class="eyebrow">Flavors</p>
      <h1>{flavor.name}</h1>
      <p class="lead muted">{flavor.shortDescription}</p>
    </div>
    <MediaFrame src={flavor.mediaUrl} alt={flavor.alt} loading="eager" />
  </div>
  <FlavorStory editorial={flavor.editorial} />
  {flavor.salesChannels?.length > 0 && <section class="sales-channels" aria-labelledby={`sales-channels-${flavor.slug}`}>
    <div class="section-heading">
      <p class="eyebrow">Find this flavor</p>
      <h2 id={`sales-channels-${flavor.slug}`}>Where to Find Us</h2>
    </div>
    <ul class="sales-channel-list">
      {flavor.salesChannels.map(channel => <li>
        <a class="button" href={channel.destinationUrl} target="_blank" rel="noopener noreferrer" aria-label={channel.accessibleLabel}>{channel.name}</a>
      </li>)}
    </ul>
  </section>}
</div>
