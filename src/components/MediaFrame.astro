---
interface Props { src: string; alt: string; width?: number; height?: number; loading?: 'lazy' | 'eager'; href?: string; }
const { src, alt, width, height, loading = 'lazy', href } = Astro.props;
---
<figure class="media-frame">
  {href ? <a class="media-frame__link" href={href}><img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" /></a> : <img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" />}
</figure>
