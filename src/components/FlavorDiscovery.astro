---
import type { PublicFlavor } from './public-view';
import FlavorCard from './FlavorCard.astro';
interface Props { flavors: PublicFlavor[]; }
const { flavors } = Astro.props;
const hasMultipleFlavors = flavors.length > 1;
---
<div class="flavor-discovery">
  {hasMultipleFlavors && <p class="flavor-swipe-hint" aria-hidden="true">Swipe to explore <span>→</span></p>}
  <div class:list={['flavor-grid', { 'flavor-grid--carousel': hasMultipleFlavors }]} role="list" aria-label="Tropical Trance flavors">
    {flavors.map(flavor => <FlavorCard flavor={flavor} />)}
  </div>
</div>
