---
interface Props { whatsappBusinessUrl?: string | null; }
const { whatsappBusinessUrl = null } = Astro.props;
---
<section class="contact-panel" aria-labelledby="contact-heading">
  <p class="eyebrow">Contact</p>
  <h2 id="contact-heading">WhatsApp Business</h2>
  {whatsappBusinessUrl
    ? <a class="button" href={whatsappBusinessUrl} target="_blank" rel="noopener noreferrer" aria-label="Message Tropical Trance on WhatsApp (opens in a new tab)">Message us on WhatsApp <span aria-hidden="true">↗</span></a>
    : <p class="status-line">Coming Soon</p>}
  <a class="button" href="/">Return Home <span aria-hidden="true">↗</span></a>
</section>
