---
import { navigation } from './navigation.mjs';
const pathname = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">Tropical Trance</a>
    <nav class="primary-nav" aria-label="Primary">
      <ul>{navigation.map(([href, label]) => <li><a href={href} aria-current={pathname === href ? 'page' : href === '/flavors/' && pathname.startsWith('/flavors/') ? 'location' : undefined}>{label}</a></li>)}</ul>
    </nav>
  </div>
</header>
