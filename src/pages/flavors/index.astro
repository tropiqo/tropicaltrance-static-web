---
import SiteLayout from '../../layouts/SiteLayout.astro';
import EditorialHero from '../../components/EditorialHero.astro';
import FlavorCollection from '../../components/FlavorCollection.astro';
import release from '#public-release';
const collectionDescription = !release.review && release.flavors.length === 1 ? release.flavors[0].shortDescription : undefined;
---
<SiteLayout title="Flavors" description={collectionDescription ?? "Empty development-only collection."}>
  <EditorialHero title="Flavors" description={collectionDescription ?? "Local development preview — not a public release."} eyebrow="Tropical Trance" />
  <FlavorCollection flavors={release.flavors} />
</SiteLayout>
