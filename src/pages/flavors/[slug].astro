---
import LocalizedPage from '../../components/LocalizedPage.astro';
import release from '#public-release';
export function getStaticPaths() {
  return release.flavors.map(flavor => ({ params: { slug: flavor.slug }, props: { flavor } }));
}
const { flavor } = Astro.props;
---
<LocalizedPage page="detail" locale="en" flavor={flavor} />
