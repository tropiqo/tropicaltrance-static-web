---
import SiteLayout from '../layouts/SiteLayout.astro';
import release from '#public-release';
import EditorialHero from '../components/EditorialHero.astro';
import EditorialSection from '../components/EditorialSection.astro';
import TrancyMedia from '../components/TrancyMedia.astro';
---
<SiteLayout title="About" description="A tropical state of mind. A character all its own.">
  <EditorialHero title="About" description="A tropical state of mind. A character all its own." eyebrow="Tropical Trance" decoration="tide" atmosphere />
  {release.brandMedia['about-mascot'] && <EditorialSection variant="split" title="Meet Trancy" eyebrow="Tropical Trance" atmosphere>
    <p class="lead">Trancy is the Tropical Trance mascot.</p>
    <p>The character at the heart of Tropical Trance.</p>
    <TrancyMedia slot="visual" media={release.brandMedia['about-mascot']} />
  </EditorialSection>}
  <EditorialSection variant="text" title="Flavors" eyebrow="Tropical Trance">
    {release.flavors.length === 0 && <p class="lead">No flavors are included in this development build.</p>}
    <div class="actions"><a class="button" href="/flavors/">View Flavors <span aria-hidden="true">↗</span></a><a class="button" href="/contact/">Contact <span aria-hidden="true">↗</span></a></div>
  </EditorialSection>
</SiteLayout>
